# Server
PORT=3002
NODE_ENV=development

# Primary database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=mipool
DB_SSL=false

# User database (shared delta schema on same server)
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_USERNAME=
USER_DB_PASSWORD=
USER_DB_NAME=
USER_DB_SCHEMA=delta

# Optional Redis (leave unset to use in-memory cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Auth
JWT_SECRET=

# MIPS API
MIPS_BASE_URL=
MIPS_API_KEY=
MIPS_PAYOUTS_KEY=
MIPS_REWARDS_KEY=
MIPS_REWARD_URL=
REWARD_TYPE=FPPS
REWARD_SOURCE=mipool
TIMEZONE=Asia/Dubai

# Azure Communication Services
AZURE_COMMUNICATION_SERVICE_CONNECTION_STRING=
AZURE_SENDER_EMAIL=
ADMIN_EMAIL=
# Optional: ops alert cooldown for Redis/API failures (ms). Default 6 hours.
# OPS_ALERT_COOLDOWN_MS=21600000

# Cron
REWARDS_CRON_SECRET=
REWARDS_CRON_MAX_FAILURES_PER_DAY=5

# Grafana Cloud Profiles / Pyroscope
PYROSCOPE_SERVER_ADDRESS=https://your-grafana-cloud-profiles-url
PYROSCOPE_BASIC_AUTH_USER=your-grafana-stack-user-id
PYROSCOPE_BASIC_AUTH_PASSWORD=your-grafana-cloud-access-policy-token
PYROSCOPE_APPLICATION_NAME=ms-api
